# Copiá este archivo a .env (que no se sube al repo) y completá las contraseñas.
# Son solo para desarrollo: en producción los secretos van en archivos del servidor.

POSTGRES_ADMIN_PASSWORD=cambiame
MOSTRADOR_APP_PASSWORD=cambiame-tambien

# Migraciones y semillas (usuario administrador)
DATABASE_ADMIN_URL=postgres://mostrador_admin:cambiame@127.0.0.1:5432/mostrador
# API (rol mostrador_app, sujeto a RLS)
DATABASE_URL=postgres://mostrador_app:cambiame-tambien@127.0.0.1:5432/mostrador

# Pruebas de integración: base de mantenimiento del mismo servidor; se crean bases de prueba aparte.
TEST_DATABASE_ADMIN_URL=postgres://mostrador_admin:cambiame@127.0.0.1:5432/postgres

# API
APP_ORIGEN=http://localhost:5173
COOKIES_INSEGURAS=1
# Claves de cifrado (en producción: MOSTRADOR_CLAVES_ARCHIVO=/run/secrets/claves.json)
MOSTRADOR_CLAVES={"actual":1,"claves":{"1":"<32 bytes en base64: openssl rand -base64 32>"}}

# Redis para la cola del worker (opcional en desarrollo)
REDIS_URL=redis://127.0.0.1:6379

# Mercado Pago (opcional; sin esto el cobro con QR queda deshabilitado)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# MP_PRUEBAS=1 para usar el entorno de pruebas de Mercado Pago

# Panel admin (solo por Tailscale)
MOSTRADOR_PANEL_PASSWORD=cambiame-panel
DATABASE_PANEL_URL=postgres://mostrador_panel:cambiame-panel@127.0.0.1:5432/mostrador
PANEL_ORIGEN=http://127.0.0.1:8081
