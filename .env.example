# Copiá este archivo a .env (que no se sube al repo) y completá las contraseñas.
# Son solo para desarrollo: en producción los secretos van en archivos del servidor.

POSTGRES_ADMIN_PASSWORD=cambiame
MOSTRADOR_APP_PASSWORD=cambiame-tambien

# Migraciones y semillas (usuario administrador)
DATABASE_ADMIN_URL=postgres://mostrador_admin:cambiame@127.0.0.1:5432/mostrador
# API (rol mostrador_app, sujeto a RLS)
DATABASE_URL=postgres://mostrador_app:cambiame-tambien@127.0.0.1:5432/mostrador

# Pruebas de integración: base de mantenimiento del mismo servidor; se crean bases de prueba aparte.
TEST_DATABASE_ADMIN_URL=postgres://mostrador_admin:cambiame@127.0.0.1:5432/postgres
