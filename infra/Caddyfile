# Caddy detrás de Cloudflare (sección 5). Cloudflare termina el HTTPS público; entre Cloudflare y
# este servidor se usa el certificado de origen de Cloudflare (modo SSL "Full (strict)").
{
	admin off
	servers {
		# Rangos de Cloudflare (https://www.cloudflare.com/ips/). Revisarlos cada tanto.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMINIO}:443 {
	tls /certificados/origen.pem /certificados/origen.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# El chequeo de salud es interno: no se publica.
	handle /health* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		@inmutables path /assets/*
		header @inmutables Cache-Control "public, max-age=31536000, immutable"
		@sinCache path /sw.js /registerSW.js /index.html /manifest.webmanifest /tema.js
		header @sinCache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
