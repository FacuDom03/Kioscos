{
  "name": "mostrador",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contraste": "pnpm --filter @mostrador/ui contraste",
    "db:migrar": "pnpm --filter @mostrador/db migrar",
    "db:semillas": "pnpm --filter @mostrador/db semillas",
    "dev:web": "pnpm --filter @mostrador/web dev",
    "dev:api": "pnpm --filter @mostrador/api dev",
    "e2e": "pnpm --filter @mostrador/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
